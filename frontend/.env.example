# ---- Backend API base URL ----
# In production (frontend on Hostinger, backend on Railway/VPS), point this at
# your live backend URL. Leave blank in local dev — Vite's proxy (vite.config.js)
# forwards /api and /uploads to http://localhost:5000 automatically.
VITE_API_URL=

# ---- Google reCAPTCHA v2 site key (public) ----
# Create keys at https://www.google.com/recaptcha/admin — put the SECRET key in
# backend/.env as RECAPTCHA_SECRET_KEY, and the SITE key here. Leave blank to
# skip reCAPTCHA entirely (both Register and Login keep working without it).
VITE_RECAPTCHA_SITE_KEY=
