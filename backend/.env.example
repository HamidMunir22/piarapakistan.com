# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=https://www.piarapakistan.com
SERVER_URL=https://api.piarapakistan.com

# ---- Database (MongoDB Atlas recommended - free tier available) ----
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/piarapakistan

# ---- JWT Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Email (for OTP + receipts) ----
# IMPORTANT: We use Resend's HTTP API (https://resend.com), NOT SMTP.
# SMTP (port 465/587) is blocked outbound on Railway's free tier, so Gmail
# and Hostinger SMTP both failed with "Connection timeout" no matter how they
# were configured. An HTTP API call (port 443) is never blocked.
# 1. Sign up at https://resend.com (free tier is plenty for OTP volume).
# 2. Add & verify your sending domain (piarapakistan.com) — Resend gives you
#    DNS records to add in Hostinger's DNS Zone Editor.
# 3. Create an API key at https://resend.com/api-keys and put it below.
RESEND_API_KEY=
EMAIL_FROM="PiaraPakistan <noreply@piarapakistan.com>"

# Where Contact page / Help Center messages get emailed to when a user submits one
CONTACT_EMAIL=services@piarapakistan.com

# ---- SMS OTP (Twilio - or replace with a local Pakistani SMS gateway like Telenor/Jazz SMS API) ----
# IMPORTANT: If these are left blank (or invalid), OTP SMS silently falls back
# to "dev mode" (just logged on the server, never actually sent to the phone).
# This is the #1 reason users report "OTP code nahi aata". Every OTP is ALSO
# emailed automatically as a guaranteed fallback, but for real SMS delivery in
# Pakistan you need a number/trunk that can actually send to +92 — many Twilio
# trial numbers cannot. Verify your Twilio number supports Pakistan, or switch
# to a local aggregator that does (e.g. a Jazz/Telenor SMS API reseller).
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ---- Google reCAPTCHA v2/v3 (leave blank to skip verification automatically) ----
# Create keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
# (Site/public key goes in the FRONTEND .env as VITE_RECAPTCHA_SITE_KEY, not here)

# ---- Login security ----
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=30

# ---- JazzCash (leave blank to use Mock/Test payment mode automatically) ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_MODE=sandbox

# ---- Easypaisa (leave blank to use Mock/Test payment mode automatically) ----
EASYPAISA_STORE_ID=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_MODE=sandbox

# ---- File uploads ----
MAX_FILE_SIZE_MB=5

# ---- Admin seed account (one-time - used only by `node seedAdmin.js`) ----
# Change the password before running in production, then log in and change it
# again from the account settings page immediately after first login.
ADMIN_EMAIL=admin@piarapakistan.com
ADMIN_PHONE=+923000000000
ADMIN_PASSWORD=ChangeMe123!
